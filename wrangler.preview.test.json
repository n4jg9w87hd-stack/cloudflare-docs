{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cloudflare-docs-preview-test",
	"account_id": "b54f07a6c269ecca2fa60f1ae4920c99",
	"compatibility_date": "2025-06-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": 
	"rules": [
		{ "type": "Text", "globs": ["**/__redirects"], "fallthrough": false },
		{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": false }
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": 
		"run_worker_first": false
	},
	"r2_buckets": [
		{ "binding": "MIDDLECACHE", "bucket_name": "middlecache" },
		{ "binding": "PRIVATE_ASSETS", "bucket_name": "cloudflare-docs-private" }
	]
}
